# --- Secrets / config ---
.env
!.env.example

# --- Multi-agent workflow transient state ---
.github/agents/handoffs/.subagent_start

# --- Virtual environments ---
venv/
.venv/
.venv-win/
env/
ENV/

# --- Python caches / build artifacts ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/
