# --- Debug logs from driver_logger ---
# Ignore all runtime debug dumps (HTML/PNG/JSON can contain account PII), but
# keep the directory present in a fresh clone via a tracked .gitkeep.
debug_logs/*
!debug_logs/.gitkeep

