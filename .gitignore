# --- Debug logs from driver_logger ---
debug_logs/

# --- Self-healing rewrites generated by the nodriver browser at runtime ---
# Ignore the generated rewrites but keep the directory (mounted into the Docker
# container so in-container heals land in the working tree for review).
grocery_browser/updated_functions/*
!grocery_browser/updated_functions/.gitkeep

# --- Docker / local DB artifacts ---
*.dump
*.sql.bak

# --- Exported HEB session (machine-local) ---
.texas-grocery-mcp/

# --- OS files ---
.DS_Store
Thumbs.db
desktop.ini