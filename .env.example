# auto_grocier configuration template.
# Copy this file to .env and fill in your real values:
#   cp .env.example .env
# .env is gitignored; never commit real secrets. Real environment variables
# (e.g. from Docker Compose) override values set here.

# === HEB account — used by the browser login flow ===
EMAIL=your-heb-email@example.com
PASSWORD=your-heb-password

# === Gmail IMAP — fetches HEB email-verification codes ===
# EMAIL_PASS must be a Gmail "app password" (not your normal password).
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your gmail app password

# === Claude / Anthropic API ===
CLAUDE_API_KEY=sk-ant-your-key-here

# === Database ===
# On the host these point at localhost:5432. In Docker, the compose file sets
# DATABASE_URL to reach the "postgres" service, which overrides these.
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=auto_grocier
DATABASE_USER=grocier_user
DATABASE_PASSWORD=change-me

# === HEB store + program mode ===
# STORE_ID: find via heb.com (e.g. 737 = The Heights Houston).
STORE_ID=737
# Default location used to prefill the store-search prompt (zip or address).
STORE_SEARCH_ADDRESS=
# Ingredient source: hardcoded | urls | database
INGREDIENT_SOURCE=hardcoded
# Program mode: login_export, test, checkout_with_prompt, auto_checkout,
#               graphql, graphql_checkout_with_prompt, graphql_auto_checkout,
#               update_graphql_hashes
MODE=test
