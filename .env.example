# ============================================================
# Auto Grocier — configuration template
# Copy this file to .env and fill in your real values.
# Format: KEY=VALUE  (lines starting with # are comments)
# .env is git-ignored. Never commit real credentials.
# ============================================================

# --- HEB Account Credentials (used for browser login) ---
EMAIL=your-heb-email@example.com
PASSWORD=your-heb-password

# --- Gmail IMAP (used to auto-read HEB 2FA verification codes) ---
# EMAIL_USER is the Gmail address that receives HEB verification emails.
# EMAIL_PASS must be a Gmail "App Password" (16 chars), NOT your normal
# password. Create one at https://myaccount.google.com/apppasswords
EMAIL_USER=your-gmail@example.com
EMAIL_PASS=your-gmail-app-password

# --- Claude / Anthropic API ---
CLAUDE_API_KEY=your-claude-api-key-here

# --- OpenAI API (legacy, only if using GPT) ---
OPENAI_ORG=your-openai-org-id
OPENAI_API_KEY=your-openai-key

# --- PostgreSQL Database Configuration ---
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=auto_grocier
DATABASE_USER=grocier_user
DATABASE_PASSWORD=your_secure_password

# --- HEB Store ---
STORE_ID=737
STORE_SEARCH_ADDRESS=78701

# --- Program Mode ---
# test, checkout_with_prompt, auto_checkout,
# graphql, graphql_checkout_with_prompt, graphql_auto_checkout,
# update_graphql_hashes
MODE=test

# --- Ingredient Source ---
# hardcoded (default), urls, or database
INGREDIENT_SOURCE=hardcoded

# --- Chrome / Selenium ---
# Major Chrome version for undetected-chromedriver. Leave blank to auto-detect.
CHROME_VERSION_MAIN=
