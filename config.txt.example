# Configuration File Template
# Copy this file to config.txt and fill in your actual credentials
# Format: KEY=VALUE

# HEB Account Credentials
EMAIL=your-email@example.com
PASSWORD=your-heb-password

# OpenAI API (if using GPT)
OPENAI_ORG=your-openai-org-id
OPENAI_API_KEY=your-openai-key

# Claude API (currently used)
CLAUDE_API_KEY=your-claude-api-key-here

# PostgreSQL Database Configuration
DATABASE_HOST=localhost
DATABASE_PORT=5432
DATABASE_NAME=auto_grocier
DATABASE_USER=grocier_user
DATABASE_PASSWORD=your_secure_password

# HEB Store ID for GraphQL mode (find via heb.com; e.g. 737 = The Heights Houston)
STORE_ID=737

# Default location used to prefill the store-search prompt (zip or address)
STORE_SEARCH_ADDRESS=78701

# Program Mode: test, checkout_with_prompt, auto_checkout,
#               graphql, graphql_checkout_with_prompt, graphql_auto_checkout,
#               update_graphql_hashes (refresh GraphQL persisted-query hashes)
MODE=test

# Ingredient Source: hardcoded (default), urls, or database
#   database = ask which recipes you want this week and load matching
#              recipes' ingredients from the database (run database/seed_recipes.py first)
INGREDIENT_SOURCE=hardcoded
