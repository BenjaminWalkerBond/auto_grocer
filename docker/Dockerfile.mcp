# Dockerized auto_grocer MCP server.
#
# Pure-GraphQL at runtime, but bundles Chromium + Xvfb so it can ALSO refresh its
# own HEB session in-container via the nodriver login_export flow (AUTO_GROCER_
# LOGIN_MODE=nodriver). The server speaks MCP over stdio.
#
# Build (from repo root):
#   docker compose -f docker/docker-compose.yml build mcp
# Run is wired through docker-compose.yml (so Postgres starts first).

FROM python:3.12-slim

# --- System deps: Chromium (for nodriver) + Xvfb (virtual display) + fonts ---
# Chromium pulls most of its shared-library deps automatically; Xvfb gives the
# headful browser a display, which evades more anti-bot checks than --headless.
RUN apt-get update && apt-get install -y --no-install-recommends \
        chromium \
        xvfb \
        ca-certificates \
        fonts-liberation \
        dumb-init \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# --- uv (pinned static binary; no pip) ---
COPY --from=ghcr.io/astral-sh/uv:0.12.2 /uv /usr/local/bin/uv

# Install deps into the image's SYSTEM Python (not a project .venv) so the
# CMD `python -m auto_grocer.mcp_server`, compose/skill invocations of
# `python -m auto_grocer.session_maintenance.run`, and .vscode/mcp.json all keep
# working with bare `python`. UV_LINK_MODE=copy avoids cross-layer hardlink
# warnings.
ENV UV_PROJECT_ENVIRONMENT=/usr/local \
    UV_LINK_MODE=copy \
    UV_COMPILE_BYTECODE=1

# --- Python deps (cached layer) ---
# Copy only the lock inputs first, then sync deps WITHOUT the project itself so
# this layer is reused unless deps change. --no-install-project skips building
# the src-layout package (whose source isn't copied yet).
COPY pyproject.toml uv.lock .python-version ./
RUN uv sync --frozen --no-dev --no-install-project

# --- Application code ---
COPY . .

# Now install the project itself (editable) so `auto_grocer` / `auto_grocer_mcp`
# import from /app/src and the console scripts are on PATH.
RUN uv sync --frozen --no-dev

# Ensure the entrypoint is executable (the +x bit is not preserved from Windows).
RUN chmod +x /app/docker/entrypoint.sh

# Runtime configuration for the containerized browser + login path.
ENV PYTHONUNBUFFERED=1 \
    PYTHONIOENCODING=utf-8 \
    DISPLAY=:99 \
    AUTO_GROCER_NO_SANDBOX=1 \
    NODRIVER_BROWSER_PATH=/usr/bin/chromium \
    HOME=/root

# Session files live here; mounted as a volume so the refreshed auth.json
# persists across container restarts.
RUN mkdir -p /root/.texas-grocery-mcp

# dumb-init reaps zombie Chromium processes; the entrypoint starts Xvfb then the
# requested command (default: the MCP stdio server).
ENTRYPOINT ["/usr/bin/dumb-init", "--", "/app/docker/entrypoint.sh"]
CMD ["python", "-m", "auto_grocer.mcp_server"]
